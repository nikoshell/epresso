---
from epresso.routing import Route

# Page actions (copy page + markdown menu) are on by default. Turning them off
# also stops the per-page ``<page>.md`` routes the menu links to.
page_actions = bool((site.config.theme or {}).get("page_actions", True))


def crumbs_for(by_id: dict, path: str) -> list[dict]:
    """Breadcrumb items for a doc path: Home, ancestor dirs (linked when they're
    hub pages), then the current doc (plain)."""
    segs = [s for s in path.split("/") if s]
    out: list[dict] = [{"label": "Home", "href": "/", "current": False}]
    for i in range(len(segs) - 1):  # ancestor dirs, up to (not incl.) the leaf
        prefix = "/".join(segs[: i + 1])
        hub = by_id.get(prefix)
        if hub:
            item = {"label": hub.data.title, "current": False}
            if (hub.computed or {}).get("has_page", True):
                item["href"] = f"/{hub.id}/"
            out.append(item)
        else:
            out.append({"label": segs[i].replace("-", " ").title(), "current": False})
    leaf = by_id.get(path)
    label = leaf.data.title if leaf else (segs[-1] if segs else "").replace("-", " ").title()
    out.append({"label": label, "current": True})
    return out


def _markdown_body(d) -> str:
    """A doc's raw markdown, guaranteed to open with its title as an H1."""
    body = (d.body or "").strip()
    if not body:
        return ""
    if not body.startswith("# "):
        body = f"# {d.data.title}\n\n{body}"
    return body + "\n"


def get_static_paths():
    all_docs = list(site.get_collection("docs"))
    docs = sorted(
        (d for d in all_docs if d.id != "" and (d.computed or {}).get("has_page", True)),
        key=lambda d: (d.computed or {}).get("order", 0),
    )
    by_id = {d.id: d for d in all_docs}
    chain = [d for d in docs if not (d.computed or {}).get("hidden")]  # nav-unlisted: no prev/next
    pos = {d.id: i for i, d in enumerate(chain)}
    n = len(chain)
    routes = []
    for d in docs:
        c = d.computed or {}
        j = pos.get(d.id)
        prev = chain[(j - 1) % n] if j is not None and n > 1 else None
        nxt = chain[(j + 1) % n] if j is not None and n > 1 else None
        # The page's own markdown, served at ``<page>.md`` so readers (and LLMs)
        # can take it away verbatim. Body-less hubs have none (no route, no menu).
        md_body = _markdown_body(d) if page_actions else ""
        md_path = f"/{d.id}.md" if d.id else "/index.md"
        routes.append(
            Route(
                path=f"/{d.id}/",
                params={
                    "slug": d.id,
                    "markdown": md_path if md_body else "",
                    "crumbs": crumbs_for(by_id, d.id),
                    "source": c.get("source", ""),
                    "source_url": c.get("source_url", ""),
                    "prev": {"url": f"/{prev.id}/", "title": prev.data.title} if prev else None,
                    "next": {"url": f"/{nxt.id}/", "title": nxt.data.title} if nxt else None,
                    "headings": d.headings,
                },
                data=d,
                cache_key=d.digest,
            )
        )
        if md_body:
            routes.append(
                Route(
                    path=md_path,
                    content_type="text/markdown; charset=utf-8",
                    body=md_body,
                    source=d.file_path,
                    data=d,
                    cache_key=f"{d.digest}:md",
                )
            )
    return routes
---

<DocsPage title={props.title + ' · ' + site.config.site.name} current={params.slug | default('')} headings={params.headings | default([])} path={route.path}>
    <DocsBreadcrumbs crumbs={params.crumbs} />
    {% if page_actions %}
        <DocsPageActions source={params.source} source_url={params.source_url} markdown={params.markdown} prev={params.prev} next={params.next} />
    {% endif %}
    <article class="doc">
        <h1>
            {{ props.title }}
        </h1>
        {% if props.description %}
            <p class="doc-description">
                {{ props.description }}
            </p>
        {% endif %}
        <DocsMarkdown content={content} />
        <DocsPager prev={params.prev} next={params.next} />
    </article>
    <div class="doc-end-pad"></div>
</DocsPage>
