---
---

<Doc title={'404 · ' + site.config.site.name} current={''} headings={[]} path={route.path}>
    <article class="doc">
        <h1>404 — Not Found</h1>
        <p class="doc-description">The page you're looking for doesn't exist or has moved.</p>
        <p>
            <a href="{{ url('/') }}">Back to the docs</a>
        </p>
    </article>
</Doc>
