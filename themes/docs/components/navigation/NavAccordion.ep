---
from markupsafe import Markup, escape

# The caret path lives once, as a <symbol> in the body; each row references it
# with <use>. Inlining the SVG per row cost ~320 B x 135 rows on every page.
_CARET_REF = '<svg class="tree-caret" width="14" height="14" aria-hidden="true"><use href="#epresso-caret"/></svg>'


def _build_tree(docs):
    """Group docs into a nested tree of ``{hub, dirs, docs}`` (pure data)."""
    root: dict = {"hub": None, "dirs": {}, "docs": []}
    for d in docs:
        if d.id == "":
            continue
        c = d.computed or {}
        node = root
        for part in c.get("group_path", []):
            node = node["dirs"].setdefault(part, {"hub": None, "dirs": {}, "docs": []})
        if c.get("is_hub") and c.get("group_path"):
            node["hub"] = d
        else:
            node["docs"].append(d)
    return root


# Default for `[theme] nav_collapse_after`: above this many nav rows (directories
# + pages) the top-level sections fold — a 1000-page docs tree as one expanded
# list is unnavigable, and the reader is usually looking for one section. The
# section holding the current page stays open. A site overrides it in site.toml.
_DEFAULT_COLLAPSE_AFTER = 40

_INDEX_CACHE: dict[tuple, dict] = {}
_NAV_CACHE: dict[tuple, str] = {}


def _build_index(docs) -> dict:
    """Group the docs once: the tree and its order map.

    Identical for every page, so it is cached across pages (:func:`_index_for`)
    instead of rebuilt for each of them.
    """
    root = _build_tree(docs)
    dir_min: dict[tuple, int] = {}
    for d in docs:
        gp = list((d.computed or {}).get("group_path", []))
        o = int((d.computed or {}).get("order", 0))
        for k in range(1, len(gp) + 1):
            key = tuple(gp[:k])
            if o < dir_min.get(key, 10**9):
                dir_min[key] = o
    return {"root": root, "dir_min": dir_min}


def _index_for(docs) -> dict:
    """Cached :func:`_build_index` for the (stable) set of doc entries."""
    key = (len(docs), id(docs[0]) if docs else 0)
    hit = _INDEX_CACHE.get(key)
    if hit is None:
        hit = _build_index(docs)
        if len(_INDEX_CACHE) >= 4:
            _INDEX_CACHE.clear()
        _INDEX_CACHE[key] = hit
    return hit


def render_sidebar(docs, collapse_after=None) -> Markup:
    """The cached, unmarked sidebar markup.

    The tree is identical on every page — the current page is marked
    client-side (see this component's <script>) — so it is rendered once per
    build rather than once per page. ``collapse_after`` comes from the theme's
    ``[theme] nav_collapse_after`` (the body reads it, so this frontmatter stays
    render-independent and is executed once per environment).
    """
    docs = list(docs)
    return Markup(_nav_for(docs, collapse_after))


def _nav_for(docs, collapse_after=None) -> str:
    """Cached :func:`_build_nav` for the (stable) set of doc entries."""
    key = (len(docs), id(docs[0]) if docs else 0, collapse_after)
    hit = _NAV_CACHE.get(key)
    if hit is None:
        hit = _build_nav(docs, collapse_after)
        if len(_NAV_CACHE) >= 4:
            _NAV_CACHE.clear()
        _NAV_CACHE[key] = hit
    return hit


def _build_nav(docs, collapse_after=None) -> str:
    """The full nested sidebar: the first level is always expanded, deeper
    directories open/close independently via native <details>."""
    index = _index_for(docs)
    dir_min = index["dir_min"]
    root = index["root"]
    rows = len(dir_min) + sum(1 for d in docs if d.id != "")
    threshold = _DEFAULT_COLLAPSE_AFTER if collapse_after in (None, "") else int(collapse_after)
    compact = rows > threshold

    def inner_for(node, name=""):
        hub = node["hub"]
        if hub:
            label = hub.data.title
            # A hub without a body is a category label only (no page to link to).
            if not (hub.computed or {}).get("has_page", True):
                return f"<span>{escape(label)}</span>"
            return f'<a href="/{escape(hub.id)}/">{escape(label)}</a>'
        label = name.replace("-", " ").title() if name else ""
        return f"<span>{escape(label)}</span>"

    def render(node, path):
        parts = ['<ul class="tree">']
        # Interleave subdirectories and pages by order (dirs use their first
        # doc's order) instead of rendering all directories first.
        entries = []
        for name, child in node["dirs"].items():
            entries.append((dir_min.get(tuple(path) + (name,), 10**9), 0, name, ("dir", name, child)))
        for d in node["docs"]:
            entries.append((int(d.computed.get("order", 0)), 1, d.data.title.lower(), ("doc", d)))
        for _o, _k, _tie, payload in sorted(entries, key=lambda e: e[:3]):
            if payload[0] == "dir":
                name, child = payload[1], payload[2]
                child_path = path + [name]
                hub = child["hub"]
                depth = len(child_path)
                _lv = depth - 1
                indent_attr = f' data-depth="{_lv}"' if _lv else ""

                # A lone hub index = a plain leaf (no container). Without a page
                # it is only a label.
                if hub and not (child["dirs"] or child["docs"]):
                    if (hub.computed or {}).get("has_page", True):
                        parts.append(
                            f'<li class="tree-leaf"{indent_attr}><a href="/{escape(hub.id)}/">{escape(hub.data.title)}</a></li>'
                        )
                    else:
                        parts.append(f'<li class="tree-leaf"{indent_attr}><span>{escape(hub.data.title)}</span></li>')
                    continue

                children_html = render(child, child_path)
                inner = inner_for(child, name)

                if depth == 1 and not compact:
                    # FIRST level: always expanded, never collapsible, no caret/icons
                    # (a nav this small does not need folding).
                    parts.append(
                        f'<li class="tree-dir tree-top"><div class="tree-head">{inner}</div>{children_html}</li>'
                    )
                else:
                    # Folded top level keeps `tree-top`, so its child list has no
                    # guide line — the same look it has when expanded.
                    top = " tree-top" if depth == 1 else ""
                    parts.append(
                        f'<li class="tree-dir{top}"{indent_attr}><details>'
                        f"<summary>{inner}{_CARET_REF}</summary>"
                        f"{children_html}</details></li>"
                    )
            else:
                d = payload[1]
                _dlv = len(path)
                doc_indent = f' data-depth="{_dlv}"' if _dlv else ""
                parts.append(
                    f'<li class="tree-leaf"{doc_indent}><a href="/{escape(d.id)}/">{escape(d.data.title)}</a></li>'
                )
        parts.append("</ul>")
        return "".join(parts)

    return Markup(render(root, []))
---

<Fragment>
    <svg class="tree-caret-defs" width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden"><symbol id="epresso-caret" viewBox="0 0 16 16"><path fill="currentColor" d="M6.97 4.03a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06L9.94 8 6.97 5.03a.75.75 0 0 1 0-1.06Z"/></symbol></svg>
    <div class="sidebar-scrim" aria-hidden="true"></div>
    <aside class="sidebar" id="sidebar-nav" aria-label="Documentation navigation">
        <div class="sidebar-inner">
            <nav>
                {{ render_sidebar(props.docs, (site.config.theme or {}).get("nav_collapse_after")) }}
            </nav>
        </div>
    </aside>
</Fragment>

<script>
(function() {
    "use strict";
    if (window.__epressoSidebarToggle) return;
    window.__epressoSidebarToggle = true;
    var sidebar = document.getElementById("sidebar-nav");
    var scrim = document.querySelector(".sidebar-scrim");
    if (!sidebar) return;

    // The sidebar markup is cached across pages and carries no per-page state,
    // so mark the current page here: highlight its link, mark the section head
    // it lives under, and open its ancestors. Without JS the nav still works, it
    // just is not highlighted, so this must never throw.
    (function markCurrent() {
        var path = location.pathname.replace(/\/?$/, "/");
        var link = sidebar.querySelector('a[href="' + path + '"]');
        if (!link) return;
        link.classList.add("active");
        link.setAttribute("aria-current", "page");
        for (var el = link.parentElement; el && el !== sidebar; el = el.parentElement) {
            if (el.tagName !== "LI" || !el.classList.contains("tree-dir")) continue;
            var head = el.querySelector("summary, .tree-head");
            if (head && head.contains(link)) {
                head.classList.add("active");
                continue;
            }
            var details = el.firstElementChild;
            if (details && details.tagName === "DETAILS") details.open = true;
        }
    })();

    var mq = window.matchMedia("(max-width: 1024px)");
    var FOCUSABLE = 'a[href], button:not([disabled]), summary, input, [tabindex]:not([tabindex="-1"])';

    function setOpen(open) {
        sidebar.classList.toggle("is-open", open);
        if (scrim) scrim.classList.toggle("is-open", open);
        document.body.classList.toggle("nav-open", open);
        /* Keep closed off-canvas content out of the tab order. */
        sidebar.inert = mq.matches && !open;
        var triggers = document.querySelectorAll(".sidebar-toggle");
        Array.prototype.forEach.call(triggers, function(b) {
            b.setAttribute("aria-expanded", open ? "true" : "false");
            b.setAttribute("aria-label", open ? "Hide navigation" : "Show navigation");
        });
        if (open) {
            var first = sidebar.querySelector(FOCUSABLE);
            if (first) first.focus();
        } else if (triggers.length && sidebar.contains(document.activeElement)) {
            triggers[0].focus();
        }
        if (open && window.epressoPanelOpened) window.epressoPanelOpened("sidebar");
    }
    document.addEventListener("epresso:panel-open", function(e) {
        if (e.detail !== "sidebar") setOpen(false);
    });

    function syncState() {
        if (!mq.matches && sidebar.classList.contains("is-open")) setOpen(false);
        sidebar.inert = mq.matches && !sidebar.classList.contains("is-open");
    }
    syncState();
    if (mq.addEventListener) mq.addEventListener("change", syncState);
    /* Delegated: the toggle lives in the ToC bar, which is rendered after
       this script. */
    document.addEventListener("click", function(e) {
        var btn = e.target.closest ? e.target.closest(".sidebar-toggle") : null;
        if (btn) setOpen(!sidebar.classList.contains("is-open"));
    });
    if (scrim) scrim.addEventListener("click", function() {
        setOpen(false);
    });
    document.addEventListener("keydown", function(e) {
        if (e.key === "Escape") {
            setOpen(false);
            return;
        }
        /* Trap focus inside the open drawer. */
        if (e.key !== "Tab" || !sidebar.classList.contains("is-open")) return;
        var f = sidebar.querySelectorAll(FOCUSABLE);
        if (!f.length) return;
        var first = f[0],
            last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
        }
    });
    sidebar.addEventListener("click", function(e) {
        var a = e.target.closest ? e.target.closest("a") : null;
        if (a && mq.matches) setOpen(false);
    });
})();

/* Scroll fades (see `.sidebar nav` mask-image): publish how much of the
   tree is scrolled out of view at each edge, so the gradient stops can
   track it. Recomputed on scroll, resize, and section open/close. */
(function() {
    "use strict";
    if (window.__epressoSidebarFade) return;
    window.__epressoSidebarFade = true;
    var fadeNav = document.querySelector(".sidebar nav");
    if (fadeNav) {
        var publishFades = function() {
            var max = Math.max(0, fadeNav.scrollHeight - fadeNav.clientHeight);
            var top = Math.min(Math.max(fadeNav.scrollTop, 0), max);
            fadeNav.style.setProperty("--scroll-area-overflow-y-start", top + "px");
            fadeNav.style.setProperty("--scroll-area-overflow-y-end", (max - top) + "px");
        };
        fadeNav.addEventListener("scroll", publishFades, {
            passive: true
        });
        window.addEventListener("resize", publishFades);
        document.addEventListener("toggle", publishFades, true); /* <details> open/close */
        publishFades();
    }
})();
</script>

<style>
.sidebar-scrim {
    display: none;
}

.sidebar {
    grid-area: sidebar;
    padding: var(--space-sm);
    border-right: 1px solid var(--line);
    /* As tall as the content column, so the divider runs the whole page;
           .sidebar-inner is what sticks. */
    align-self: stretch;
}

.sidebar-inner {
    position: sticky;
    top: var(--header-h);
    display: flex;
    flex-direction: column;
    max-height: 100%;
    overflow: hidden;
}

.sidebar nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* Always hidden — scrolling still works, there's just no scrollbar to
           collide with the rows' right-aligned carets. */
    scrollbar-width: none;
}

.sidebar nav::-webkit-scrollbar {
    width: 0;
}

.sidebar nav {
    position: relative;
}

/* Scroll fades: the top/bottom stops are min(fade-size, overflow), where
       the overflow amounts are set by the script below from nav.scrollTop — so
       an edge only fades once content is actually scrolled out of view. Same
       convention as Base UI / shadcn scroll areas. */
.sidebar nav {
    --scroll-area-fade-size: 1.5rem;
    /* A hover row is a fixed *step* away from the page background: lighter
           on dark (#1a1d23 vs #0f1117 = 1.118:1), darker on light (#eeeeee vs
           #fafbfc = 1.120:1) — the same lift in both. The row text follows the
           theme (--ink), since white would vanish on the light fill. */
    --tree-row-hover: light-dark(#eeeeee, #1a1d23);
    mask-image: linear-gradient(to bottom,
            transparent 0,
            #000 min(var(--scroll-area-fade-size), var(--scroll-area-overflow-y-start, 0px)),
            #000 calc(100% - min(var(--scroll-area-fade-size), var(--scroll-area-overflow-y-end, 0px))),
            transparent 100%);
}

.tree {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: var(--z-content);
}

.tree ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line);
    margin-left: 0.4rem;
}

/* Top-level groups are section headers, not real nesting — their direct
       children skip the connecting guide line that deeper subtrees keep. */
.tree-top>.tree {
    border-left: none;
}

/* Folded top level (see render_sidebar): the list now sits inside <details>. */
.tree-top>details>.tree {
    border-left: none;
}

/* Row depth -> the indent the active row's bar reaches back across. The markup
   carries data-depth; the value lives here instead of in an inline style on
   every row (1131 rows x ~44 B on a large corpus). Deeper than 10 keeps the
   default 0 — the tree is nested, so only the bar's reach is affected. */
.tree li[data-depth="1"] { --indent: calc(1 * 1.3rem + 1px); }
.tree li[data-depth="2"] { --indent: calc(2 * 1.3rem + 2px); }
.tree li[data-depth="3"] { --indent: calc(3 * 1.3rem + 3px); }
.tree li[data-depth="4"] { --indent: calc(4 * 1.3rem + 4px); }
.tree li[data-depth="5"] { --indent: calc(5 * 1.3rem + 5px); }
.tree li[data-depth="6"] { --indent: calc(6 * 1.3rem + 6px); }
.tree li[data-depth="7"] { --indent: calc(7 * 1.3rem + 7px); }
.tree li[data-depth="8"] { --indent: calc(8 * 1.3rem + 8px); }
.tree li[data-depth="9"] { --indent: calc(9 * 1.3rem + 9px); }
.tree li[data-depth="10"] { --indent: calc(10 * 1.3rem + 10px); }

.tree li {
    position: relative;
}

/* collapsible (depth >= 2) sections */
.tree details {
    margin: 0;
}

.tree summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
    font-size: 0.92rem;
    line-height: 1.4;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}

.tree summary::-webkit-details-marker {
    display: none;
}

.tree summary:hover:not(.active) {
    background: var(--tree-row-hover);
    color: var(--ink);
}

.tree summary:hover:not(.active)>a {
    color: var(--ink);
}

.tree-caret {
    margin-left: auto;
    transition: transform 0.12s ease, color var(--dur-fast) var(--ease);
    color: var(--muted);
    flex: none;
}

.tree summary:hover:not(.active) .tree-caret {
    color: var(--ink);
}

.tree details[open]>summary .tree-caret {
    transform: rotate(90deg);
}

/* FIRST level: always expanded, not a <details>, no caret/icon */
.tree-top>.tree-head {
    display: block;
    padding: 0;
    margin: 0.15rem 0;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.4;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}

.tree-top>.tree-head:has(> a):hover:not(.active) {
    background: var(--tree-row-hover);
    color: var(--ink);
}

.tree-top>.tree-head:hover:not(.active)>a {
    color: var(--ink);
}

.tree summary a,
.tree-head a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
}

/* Label-only rows (no page link) get the same box height as link rows. */
.tree summary>span,
.tree .tree-head>span,
.tree li.tree-leaf>span {
    display: flex;
    align-items: center;
    padding: 0.28rem 0.4rem;
}

.tree a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.4;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}

.tree a:hover:not(.active) {
    background: var(--tree-row-hover);
    color: var(--ink);
}

/* Active page: full-width highlight with the same geometry as the
       sliding hover bar (extends across the item's indentation). */
.tree .active {
    position: relative;
}

.tree .active::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: calc(-1 * var(--indent, 0rem));
    right: 0;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    z-index: var(--z-behind);
}

.tree .active a,
.tree a.active {
    color: var(--accent);
}

.tree .tree-head.active>a,
.tree summary.active>a {
    background: transparent;
}

:global(html[data-nav-mode="compact"]) .tree ul {
    border-left: none;
    padding-left: 0;
    margin-left: 0;
}

:global(html[data-nav-mode="compact"]) .tree .active::before {
    left: 0;
}

:global(html[data-nav-mode="compact"]) .sidebar-scrim {
    display: block;
    position: fixed;
    /* the header stays above/undimmed; the scrim covers the content area */
    top: var(--header-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-scrim);
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
}

:global(html[data-nav-mode="compact"]) .sidebar-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
}

:global(html[data-nav-mode="compact"]) .sidebar {
    position: fixed;
    /* Stop at the header: it (and its toggle) stays visible, so the drawer
           needs no close button of its own. */
    top: var(--header-h);
    right: 0;
    bottom: auto;
    height: calc(100vh - var(--header-h));
    height: calc(100dvh - var(--header-h));
    width: min(20rem, 85vw);
    max-height: none;
    padding: var(--space-sm);
    padding-right: calc(var(--space-sm) + env(safe-area-inset-right));
    padding-bottom: calc(var(--space-sm) + env(safe-area-inset-bottom));
    border-top: none;
    border-right: none;
    border-left: 1px solid var(--line);
    background: var(--bg);
    z-index: var(--z-drawer);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateX(100%);
    transition: transform var(--dur-normal) var(--ease);
}

:global(html[data-nav-mode="compact"]) .sidebar.is-open {
    transform: translateX(0);
}

:global(html[data-nav-mode="compact"]) .sidebar nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

:global(html[data-nav-mode="compact"]) .sidebar-inner {
    /* The drawer itself is the flex column. */
    position: static;
    height: auto;
    max-height: none;
    flex: 1;
    min-height: 0;
}

@media (prefers-reduced-motion: reduce) {

    .tree a,
    .tree summary,
    .tree-top>.tree-head,
    .tree-caret {
        transition: none;
    }
}
</style>
