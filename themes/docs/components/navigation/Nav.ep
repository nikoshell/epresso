---
from markupsafe import Markup, escape

ICONS = {
    "caret": '<path fill="currentColor" d="M6.97 4.03a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06L9.94 8 6.97 5.03a.75.75 0 0 1 0-1.06Z"/>',
    "folder": '<path fill="currentColor" d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"/>',
    "file": '<path fill="currentColor" d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Z"/>',
}


def icon(name: str, class_name: str = "", size: int = 0) -> str:
    """Wrap an icon path in an ``<svg>`` (16×16, currentColor)."""
    cls = f' class="{class_name}"' if class_name else ""
    dims = f' width="{size}" height="{size}"' if size else ""
    return f'<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"{dims}{cls}>{ICONS[name]}</svg>'


def _build_tree(docs):
    """Group docs into a nested tree of ``{hub, dirs, docs}`` (pure data)."""
    root: dict = {"hub": None, "dirs": {}, "docs": []}
    for d in docs:
        if d.id == "":
            continue
        c = d.computed or {}
        node = root
        for part in c.get("group_path", []):
            node = node["dirs"].setdefault(part, {"hub": None, "dirs": {}, "docs": []})
        # A hub only heads a directory section; a lone index flattened to root
        # (group_path == []) is a plain top-level page.
        if c.get("is_hub") and c.get("group_path"):
            node["hub"] = d
        else:
            node["docs"].append(d)
    return root


def render_sidebar(docs, current: str) -> Markup:
    """Sidebar: VSCode-style tree, auto-opened around the active doc."""
    docs = list(docs)
    by_id = {d.id: d for d in docs}
    root = _build_tree(docs)
    active = by_id.get(current)
    active_path = list((by_id.get(current) or {}).computed.get("group_path", [])) if by_id.get(current) else []

    # A directory sorts by the earliest (curated) loader order among its docs, so
    # the sidebar matches the docs loader's category ordering rather than alpha.
    dir_min: dict[tuple, int] = {}
    for d in docs:
        gp = list((d.computed or {}).get("group_path", []))
        o = int((d.computed or {}).get("order", 0))
        for k in range(1, len(gp) + 1):
            key = tuple(gp[:k])
            if o < dir_min.get(key, 10**9):
                dir_min[key] = o

    def render(node, path):
        parts = ['<ul class="tree">']
        for name in sorted(
            node["dirs"].keys(),
            key=lambda n: (dir_min.get(tuple(path) + (n,), 10**9), n),
        ):
            child = node["dirs"][name]
            child_path = path + [name]
            hub = child["hub"]
            if hub and not (child["dirs"] or child["docs"]):
                active_attr = ' class="active" aria-current="page"' if hub.id == current else ""
                parts.append(
                    f'<li class="tree-leaf"><a href="/{escape(hub.id)}/"{active_attr}>{escape(hub.data.title)}</a></li>'
                )
                continue
            label = hub.data.title if hub else name.replace("-", " ").title()
            if hub:
                hub_active = ' class="active" aria-current="page"' if current == hub.id else ""
                inner = f'<a href="/{escape(hub.id)}/"{hub_active}>{escape(label)}</a>'
            else:
                inner = f"<span>{escape(label)}</span>"
            if not (child["dirs"] or child["docs"]):
                parts.append(
                    f'<li class="tree-empty">{icon("caret", "tree-caret", 14)}{icon("folder", "tree-icon", 14)}{inner}</li>'
                )
                continue
            on_path = bool(active_path) and active_path[: len(child_path)] == child_path
            opened = (len(active_path) > len(child_path) and on_path) or (
                active_path == child_path and active_path and (hub is None or current != hub.id)
            )
            parts.append(
                f'<li class="tree-dir"><details{" open" if opened else ""}>'
                f"<summary>{icon('caret', 'tree-caret', 14)}{icon('folder', 'tree-icon', 14)}{inner}</summary>"
                f"{render(child, child_path)}</details></li>"
            )
        for d in sorted(node["docs"], key=lambda x: (x.computed.get("order", 0), x.data.title.lower())):
            active_attr = ' class="active" aria-current="page"' if d.id == current else ""
            parts.append(
                f'<li class="tree-leaf"><a href="/{escape(d.id)}/"{active_attr}>{escape(d.data.title)}</a></li>'
            )
        parts.append("</ul>")
        return "".join(parts)

    return Markup(render(root, []))
---

<aside class="sidebar" aria-label="Documentation navigation">
    <nav>
        {{ render_sidebar(props.docs, props.current) }}
    </nav>
</aside>

<style>
    .sidebar {
        grid-area: sidebar;
        padding: var(--space-xl) var(--space-sm);
        position: sticky;
        top: var(--header-h);
        align-self: start;
        max-height: calc(100vh - var(--header-h));
        overflow-y: auto;
    }

    .tree {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .tree ul {
        list-style: none;
        margin: 0;
        padding: 0 0 0 0.9rem;
        border-left: 1px solid var(--line);
        margin-left: 0.4rem;
    }

    .tree li {
        position: relative;
    }

    .tree summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.28rem 0.4rem;
        border-radius: var(--radius-sm);
        color: var(--ink);
        font-weight: 500;
        cursor: pointer;
        font-size: 0.92rem;
        line-height: 1.4;
    }

    .tree summary::-webkit-details-marker {
        display: none;
    }

    .tree summary:hover {
        background: var(--surface);
    }

    .tree .tree-caret {
        transition: transform 0.12s ease;
        color: var(--muted);
        flex: none;
    }

    .tree details[open]>summary .tree-caret {
        transform: rotate(90deg);
    }

    .tree .tree-icon {
        color: var(--muted);
        flex: none;
    }

    .tree summary a {
        color: var(--ink);
    }

    .tree a {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.28rem 0.4rem;
        border-radius: var(--radius-sm);
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.4;
        text-decoration: none;
    }

    .tree a:hover {
        color: var(--ink);
        background: var(--surface);
    }

    .tree a.active {
        color: var(--accent);
        background: var(--accent-soft);
    }


    @media (max-width: 860px) {
        .tree ul {
            border-left: none;
            padding-left: 0;
            margin-left: 0;
        }

        .tree {
            display: block;
        }
    }

    @media (max-width: 860px) {
        .sidebar {
            position: static;
            max-height: none;
            border-bottom: 1px solid var(--line);
            padding: var(--space-md);
        }
    }
</style>
