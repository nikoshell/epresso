---
from pydantic import BaseModel


class Props(BaseModel):
    id: str = ""
    class_name: str = ""
    variant: str = ""
    aria_label: str = ""
    title: str = ""
    aria_haspopup: str = ""
    href: str = ""
    external: bool = False
---

{% if props.href %}
    <a href="{{ props.href }}" class="icon-btn{% if props.variant %} icon-btn--{{ props.variant }}{% endif %}{% if props.class_name %} {{ props.class_name }}{% endif %}"{% if props.external %} target="_blank" rel="noopener noreferrer"{% endif %}{% if props.aria_label %} aria-label="{{ props.aria_label }}"{% endif %}{% if props.title %} title="{{ props.title }}"{% endif %}>
        {{ content }}
    </a>
{% else %}
    <button type="button" id="{{ props.id }}" class="icon-btn{% if props.variant %} icon-btn--{{ props.variant }}{% endif %}{% if props.class_name %} {{ props.class_name }}{% endif %}"{% if props.aria_label %} aria-label="{{ props.aria_label }}"{% endif %}{% if props.title %} title="{{ props.title }}"{% endif %}{% if props.aria_haspopup %} aria-haspopup="{{ props.aria_haspopup }}"{% endif %}>
        {{ content }}
    </button>
{% endif %}

<style>
.icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}

.icon-btn:hover {
    color: var(--ink);
    background: var(--accent-soft);
    border-color: var(--line);
    text-decoration: none;
}
</style>
