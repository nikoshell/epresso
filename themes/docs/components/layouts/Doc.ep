---
from pydantic import BaseModel


class Props(BaseModel):
    title: str = ""
    current: str = ""
    headings: list = []


docs = list(site.get_collection("docs"))
---

<Base>
<Fragment slot="title">{{ props.title }}</Fragment>
<div class="site-body">
    <NavAccordion docs={docs} current={props.current} />

    <main class="content" id="main">
        <slot />
    </main>

    <Toc placement="rail" headings={props.headings} />
</div>
</Base>

<style>
    .site-body {
        display: grid;
        grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
        grid-template-areas: "sidebar content";
        max-width: 80rem;
        margin: 0 auto;
        min-height: calc(100vh - var(--header-h) - 4rem);
    }

    @media (min-width: 1281px) {
        .site-body {
            grid-template-columns: var(--sidebar-w) minmax(0, 1fr) 15rem;
            grid-template-areas: "sidebar content toc";
            max-width: 80rem;
        }
    }

    .content {
        grid-area: content;
        min-width: 0;
        padding: var(--space-lg) var(--space-xl) var(--space-2xl) clamp(var(--space-lg), 4vw, var(--space-3xl));
        max-width: var(--content-max);
    }

    @media (max-width: 860px) {
        .site-body {
            grid-template-columns: 1fr;
            grid-template-rows: auto 1fr;
            grid-template-areas:
            "sidebar"
            "content";
        }

        .content {
            padding: var(--space-lg) var(--space-md) var(--space-2xl);
        }
    }

    .doc h1 {
        margin-bottom: var(--space-sm);
    }

    .doc-description {
        font-size: 1.1rem;
        color: var(--muted);
        margin: 0 0 var(--space-2xl);
        max-width: 38rem;
    }
</style>
