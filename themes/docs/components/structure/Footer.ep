---
---

{% set footer = site.config.theme.get('footer', {}) %}
{% set menu = footer.get('menu', []) %}
{% set debug = footer.get('debug') %}
<footer class="site-footer">
    <div class="footer-grid">
        {% if menu %}
            <nav class="footer-col footer-menu" aria-label="Footer">
                <ul>
                    {% for item in menu %}
                        <li>
                            <a href="{{ item.href if item.href.startswith('http') else url(item.href) }}">
                                {{ item.label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        {% if debug %}
            <dl class="footer-col footer-debug">
                {% if debug is mapping %}
                    {% for key, value in debug.items() %}
                        <div>
                            <dt>{{ key }}</dt><dd>{{ value }}</dd>
                        </div>
                    {% endfor %}
                {% endif %}
                <div>
                    <dt>env</dt><dd>{{ env or 'default' }}</dd>
                </div>
                <div>
                    <dt>epresso</dt><dd>{{ epresso_version }}</dd>
                </div>
            </dl>
        {% endif %}
    </div>
    <span>Built with 🖤 and <a href="https://github.com/nikoshell/epresso">epresso</a></span>
</footer>

<style>
.site-footer {
    border-top: 1px solid var(--line);
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    color: var(--muted);
    font-size: var(--text-small);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
}

/* Footer columns — the optional menu and the optional build info —
       above the credit line. auto-fit keeps a footer with one column (or a
       narrow viewport) gap-free. */
.footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-md) var(--space-lg);
    align-items: start;
    justify-items: start;
    width: 100%;
    text-align: left;
}

.footer-menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
}

.footer-menu a {
    color: var(--muted);
    text-decoration: none;
}

.footer-menu a:hover {
    color: var(--ink);
    text-decoration: underline;
}

.footer-debug {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
}

.footer-debug div {
    display: flex;
    gap: 0.4rem;
}

.footer-debug dt {
    opacity: 0.7;
}

.footer-debug dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9em;
}
</style>
