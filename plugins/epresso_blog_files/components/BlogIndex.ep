---
from pydantic import BaseModel


class Props(BaseModel):
    title: str = "Blog"
    intro: str = ""
    posts: list = []
    pager: dict = {}
    nav: dict = {}
---

<article class="doc blog-index">
    <h1>{{ props.title }}</h1>
    {% if props.intro %}<div class="blog-intro">{{ props.intro | safe }}</div>{% endif %}
    {% for post in props.posts %}
        <section class="blog-card">
            <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
            <BlogMeta post={post} />
            <div class="blog-excerpt">{{ post.excerpt | safe }}</div>
            <a class="blog-more" href="{{ post.url }}">Continue reading</a>
        </section>
    {% endfor %}
    {% if props.pager.get("pages", 1) > 1 %}
        <nav class="blog-pager" aria-label="Pages">
            {% if props.pager.prev %}<a href="{{ props.pager.prev }}" rel="prev">← Newer</a>{% endif %}
            <span>Page {{ props.pager.page }} of {{ props.pager.pages }}</span>
            {% if props.pager.next %}<a href="{{ props.pager.next }}" rel="next">Older →</a>{% endif %}
        </nav>
    {% endif %}
    <BlogArchive nav={props.nav} />
</article>

<style>
.blog-card { padding: 1.25rem 0; border-bottom: 1px solid var(--line, #d0d5dc); }
.blog-card h2 { margin: 0 0 0.35rem; }
.blog-card h2 a { color: inherit; text-decoration: none; }
.blog-more { font-weight: 600; }
.blog-pager { display: flex; justify-content: space-between; gap: 1rem; padding: 1.5rem 0; }
</style>
